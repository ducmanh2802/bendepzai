rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated user has exclusive access to their own profile & learning data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
