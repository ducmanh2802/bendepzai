{
  "name": "kho-bau-tri-thuc-lop-1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ứng dụng học tập và rèn luyện toàn diện môn Tiếng Việt, Toán và Tiếng Anh dành cho học sinh lớp 1.",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "posttest": "node scripts/audit-snapshot.mjs",
    "test:ci": "vitest run",
    "verify:quick": "npm run typecheck && npm run test:ci",
    "verify": "npm run verify:quick && npm run build && npm run check:budget",
    "qa:smoke": "node qa/run-one.mjs qa/golden-path.mjs",
    "qa:games": "node qa/run-one.mjs qa/games.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "@vercel/analytics": "^2.0.1",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
