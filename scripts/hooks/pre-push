#!/bin/sh
# pre-push — run the fast local gate before anything reaches GitHub.
# CI runs the full pipeline (build + bundle budget + browser QA) afterwards,
# so this stays at typecheck + unit tests. Bypass deliberately with: git push --no-verify
set -eu

if ! command -v npm >/dev/null 2>&1; then
  echo "⚠ Pre-push: không tìm thấy npm — bỏ qua verify." >&2
  exit 0
fi

echo "… Pre-push: npm run verify:quick (typecheck + unit tests)"
if ! npm run verify:quick --silent; then
  echo "✖ Pre-push: verify:quick thất bại — sửa rồi push lại." >&2
  exit 1
fi

echo "✔ Pre-push: passed"
